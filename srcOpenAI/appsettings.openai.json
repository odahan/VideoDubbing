{
  "Paths": {
    "ToolsRoot": ".localdub/tools",
    "ModelsRoot": ".localdub/models",
    "PythonRoot": ".localdub/python",
    "OutputRoot": "output/openai",
    "VoicesFile": "voices/profiles.json",
    "GlossariesRoot": "glossaries"
  },
  "Whisper": {
    "ModelName": "large-v3-turbo",
    "ModelFile": "ggml-large-v3-turbo.bin",
    "ModelUrl": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin",
    "Language": "fr",
    "Threads": 8,
    "MaxSegmentCharacters": 200
  },
  "Tts": {
    "ServiceUrl": "http://127.0.0.1:5055",
    "AutoStart": true,
    "Engine": "chatterbox-turbo",
    "Language": "en",
    "RequestTimeoutMinutes": 10,
    "MaxSpeedRatio": 1.15,
    "TargetWordsPerSecond": 3.0
  },
  "Audio": {
    "SampleRate": 48000,
    "BitDepth": 24,
    "DuckLevelDb": -24.0,
    "DuckingFadeMilliseconds": 150,
    "OutputCodec": "aac",
    "OutputBitrate": "320k"
  },
  "Separation": {
    "Model": "htdemucs",
    "Device": "cuda"
  },
  "OpenAI": {
    "Model": "gpt-6-luna",
    "BatchSize": 12,
    "RequestTimeoutMinutes": 5
  }
}
